PORT=4000
SERVER_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
# In production, serve everything from one domain: SERVER_URL=CLIENT_URL=https://app.yourdomain.com

# Encrypts users' LinkedIn/Instagram tokens in the database. Generate with:
#   openssl rand -base64 32
# Keep it secret and never change it (existing tokens become unreadable).
TOKEN_ENCRYPTION_KEY=

# Set to false to stop new sign-ups (e.g. private beta)
ALLOW_SIGNUPS=true
# Max AI generations per user per day (controls your Claude bill)
AI_DAILY_LIMIT=100

# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Gemini — free key at https://aistudio.google.com/apikey
# Used for writing when no ANTHROPIC_API_KEY is set (or set AI_PROVIDER=gemini), and as a backup image generator.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# AI_PROVIDER=gemini

# LinkedIn — https://www.linkedin.com/developers/apps
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Authorized redirect URL: http://localhost:4000/api/accounts/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn versions its API monthly (YYYYMM) and retires old ones after ~1 year.
LINKEDIN_API_VERSION=202608

# Instagram (Business/Creator account) — https://developers.facebook.com/apps
# Use case: "Manage messaging & content on Instagram" (Instagram API with Instagram Login)
# Redirect URL: <SERVER_URL>/api/accounts/instagram/callback  (Meta requires https — use ngrok in dev)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v23.0

# Instagram downloads your images/videos from a public URL. In development, run
# `ngrok http 4000` and put the https URL here (also use it as SERVER_URL for IG OAuth).
PUBLIC_MEDIA_URL=

# Free media providers (see README)
# Cloudflare Workers AI — free daily allowance for FLUX images
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pexels — free stock video for reels
PEXELS_API_KEY=
# Pixabay — free stock video, key shown at https://pixabay.com/api/docs/ after login
PIXABAY_API_KEY=

# Where the database and media live (point at a persistent disk in production)
# DATA_DIR=./data
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
